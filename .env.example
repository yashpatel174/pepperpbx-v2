# Backend API base URL
VITE_API_BASE_URL=http://localhost:3000/api

# WebSocket (Socket.IO) URL — only needed once live modules (Active Calls, Queues, etc.) are built
VITE_WS_URL=

# Set to "false" to use the real backend instead of the built-in mock auth/data.
# Defaults to mock ON when unset.
VITE_USE_MOCK=true
